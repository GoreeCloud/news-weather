{
  "name": "@goreecloud/news-weather",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && vite build",
    "build:web": "npm run build",
    "preview": "vite preview",
    "verify:repo": "node scripts/verify-repository.mjs",
    "tauri": "tauri",
    "test:unit": "node --test --test-concurrency=1 tests/*.test.mjs",
    "generate:icons": "tauri icon src-tauri/icons/icon.svg",
    "prepare:native": "npm run generate:icons && npm run build:web"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
